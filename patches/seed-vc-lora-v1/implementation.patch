@@ -0,0 +1,222 @@
+"""Native PyTorch LoRA for the V1 F0-conditioned singing model.
+
+Only fused attention QKV/output and the three gated-FFN projections are adapted.
+Adapter files are versioned torch tensor dictionaries, NOT PEFT checkpoints.
+"""
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+import tempfile
+
+import torch
+from torch import nn
+from torch.nn import functional as F
+
+
+FORMAT = "seed-vc-lora-v1"
+TARGET = re.compile(
+    r"estimator\.transformer\.layers\.\d+\."
+    r"(?:attention\.(?:wqkv|wo)|feed_forward\.(?:w1|w2|w3))"
+)
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def validate_config(rank=16, alpha=16.0, dropout=0.0):
+    if isinstance(rank, bool) or not isinstance(rank, int) or rank <= 0:
+        raise ValueError("LoRA rank must be a positive integer")
+    if not math.isfinite(alpha) or alpha <= 0:
+        raise ValueError("LoRA alpha must be finite and positive")
+    if not math.isfinite(dropout) or not 0 <= dropout < 1:
+        raise ValueError("LoRA dropout must be in [0, 1)")
+    return {"rank": rank, "alpha": float(alpha), "dropout": float(dropout)}
+
+
+def validate_svc_config(config):
+    params = config["model_params"]
+    if (config["preprocess_params"]["sr"] != 44100
+            or not params["DiT"].get("f0_condition")
+            or not params["length_regulator"].get("f0_condition")):
+        raise ValueError("LoRA currently requires the V1 44.1 kHz F0-conditioned SVC config")
+
+
+def architecture_signature(models, config):
+    """Bind computation settings and parameter shapes, not machine-local asset paths."""
+    p = config["model_params"]
+    core = {k: p.get(k) for k in ("dit_type", "DiT", "length_regulator", "wavenet", "reg_loss_type")}
+    core["style_dim"] = p["style_encoder"]["dim"]
+    core["speech_tokenizer_type"] = p["speech_tokenizer"]["type"]
+    core["vocoder_type"] = p["vocoder"]["type"]
+    value = {"core": core, "preprocess": config["preprocess_params"],
+             "parameters": {k: {name: list(param.shape) for name, param in net.named_parameters()}
+                            for k, net in models.items()}}
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def load_base_weights(models, path):
+    """Fail on any missing/mismatched model parameter; tolerate known unused upstream keys."""
+    payload = torch.load(path, map_location="cpu", weights_only=True)
+    if not isinstance(payload, dict) or not isinstance(payload.get("net"), dict):
+        raise ValueError("Expected a full Seed-VC base checkpoint with 'net'; not an adapter")
+    states = payload["net"]
+    filtered = {}
+    for key, net in models.items():
+        # Official V1 weights use DDP's module. prefix; mirror the upstream loader.
+        raw = states.get(key, {})
+        state = {}
+        for name, value in raw.items():
+            normalized = name[7:] if name.startswith('module.') else name
+            if normalized in state:
+                raise ValueError(f'Ambiguous base parameter after DDP normalization: {key}.{normalized}')
+            state[normalized] = value
+        bad = [name for name, param in net.named_parameters()
+               if name not in state or not isinstance(state[name], torch.Tensor)
+               or state[name].shape != param.shape]
+        if bad:
+            raise ValueError(f"Incomplete base parameters in {key}: {bad[:8]}")
+        current = net.state_dict()
+        filtered[key] = {name: value for name, value in state.items()
+                         if name in current and isinstance(value, torch.Tensor)
+                         and value.shape == current[name].shape}
+    for key, state in filtered.items():
+        models[key].load_state_dict(state, strict=False)
+    return sha256_file(path)
+
+
+class LoRALinear(nn.Module):
+    def __init__(self, base, rank=16, alpha=16.0, dropout=0.0):
+        super().__init__()
+        validate_config(rank, alpha, dropout)
+        if type(base) is not nn.Linear:
+            raise TypeError("LoRA target must be a plain nn.Linear")
+        self.base = base.requires_grad_(False)
+        self.in_features, self.out_features = base.in_features, base.out_features
+        self.rank, self.alpha, self.dropout_p = rank, float(alpha), float(dropout)
+        self.scaling = self.alpha / rank
+        self.dropout = nn.Dropout(dropout)
+        self.lora_A = nn.Parameter(base.weight.new_empty((rank, self.in_features)))
+        self.lora_B = nn.Parameter(base.weight.new_zeros((self.out_features, rank)))
+        nn.init.kaiming_uniform_(self.lora_A, a=math.sqrt(5))
+
+    def forward(self, x):
+        return self.base(x) + F.linear(F.linear(self.dropout(x), self.lora_A), self.lora_B) * self.scaling
+
+
+def inject_lora(models, rank=16, alpha=16.0, dropout=0.0):
+    """Freeze the complete core and inject one adapter; reject accidental double injection."""
+    settings = validate_config(rank, alpha, dropout)
+    if any(isinstance(m, LoRALinear) for net in models.values() for m in net.modules()):
+        raise ValueError("LoRA is already injected; load new weights into the existing adapter")
+    cfm = models["cfm"]
+    targets = [(name, module) for name, module in cfm.named_modules() if TARGET.fullmatch(name)]
+    layers = cfm.estimator.transformer.layers
+    if len(targets) != len(layers) * 5 or any(type(m) is not nn.Linear for _, m in targets):
+        raise ValueError("Expected exactly wqkv, wo, w1, w2, w3 in every Transformer layer")
+    for net in models.values():
+        net.requires_grad_(False)
+    manifest = []
+    for name, module in targets:
+        parent_name, attr = name.rsplit(".", 1)
+        wrapper = LoRALinear(module, **settings)
+        wrapper.train(module.training)
+        setattr(cfm.get_submodule(parent_name), attr, wrapper)
+        manifest.append({"name": name, "in_features": module.in_features, "out_features": module.out_features})
+    return manifest
+
+
+def adapter_parameters(models):
+    return {f"{name}.{suffix}": getattr(layer, suffix)
+            for name, layer in models["cfm"].named_modules() if isinstance(layer, LoRALinear)
+            for suffix in ("lora_A", "lora_B")}
+
+
+def make_metadata(models, base_sha256, signature, settings, targets):
+    return {"format": FORMAT, "base_sha256": base_sha256, "architecture_signature": signature,
+            "lora": settings, "targets": targets,
+            "adapter_parameters": sum(p.numel() for p in adapter_parameters(models).values())}
+
+
+def atomic_save(payload, path):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=path.name + ".", suffix=".tmp", delete=False) as stream:
+        temporary = Path(stream.name)
+    try:
+        torch.save(payload, temporary)
+        temporary.replace(path)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def save_adapter(models, path, metadata, training_state=None):
+    parameters = adapter_parameters(models)
+    if not parameters:
+        raise ValueError("No LoRA parameters to save")
+    weights = {name: p.detach().cpu().clone() for name, p in parameters.items()}
+    if not all(torch.isfinite(p).all().item() for p in weights.values()):
+        raise ValueError("Refusing to save non-finite LoRA weights")
+    payload = {"metadata": metadata, "adapter": weights}
+    if training_state is not None:
+        payload["training"] = training_state
+    atomic_save(payload, path)
+
+
+def read_adapter(path):
+    payload = torch.load(path, map_location="cpu", weights_only=True)
+    if not isinstance(payload, dict) or payload.get("metadata", {}).get("format") != FORMAT:
+        raise ValueError("Expected a seed-vc-lora-v1 adapter, not a full/PEFT checkpoint")
+    validate_config(**payload["metadata"]["lora"])
+    if not isinstance(payload.get("adapter"), dict):
+        raise ValueError("Adapter tensor dictionary is missing")
+    return payload
+
+
+def validate_adapter_identity(payload, base_sha256, signature):
+    metadata = payload["metadata"]
+    if metadata["base_sha256"] != base_sha256:
+        raise ValueError("LoRA base checkpoint SHA256 mismatch")
+    if metadata["architecture_signature"] != signature:
+        raise ValueError("LoRA model/config architecture mismatch")
+
+
+def load_adapter_weights(models, payload, expected_metadata):
+    """Validate every tensor before changing any adapter; never silently skip keys."""
+    if payload["metadata"] != expected_metadata:
+        raise ValueError("LoRA metadata/targets/settings mismatch")
+    parameters, weights = adapter_parameters(models), payload["adapter"]
+    if set(parameters) != set(weights):
+        raise ValueError("LoRA parameter keys mismatch")
+    for name, param in parameters.items():
+        value = weights[name]
+        if (not isinstance(value, torch.Tensor) or value.shape != param.shape
+                or not value.is_floating_point() or not torch.isfinite(value).all().item()):
+            raise ValueError(f"Invalid LoRA tensor: {name}")
+        if value.abs().max().item() > torch.finfo(param.dtype).max:
+            raise ValueError(f"LoRA tensor overflows destination dtype: {name}")
+    with torch.no_grad():
+        for name, param in parameters.items():
+            param.copy_(weights[name])
+
+
+def attach_adapter(models, config, base_sha256, path):
+    """Inference entry point; call after loading the full base and before moving to GPU."""
+    validate_svc_config(config)
+    payload = read_adapter(path)
+    signature = architecture_signature(models, config)
+    validate_adapter_identity(payload, base_sha256, signature)
+    settings = payload["metadata"]["lora"]
+    targets = inject_lora(models, **settings)
+    expected = make_metadata(models, base_sha256, signature, settings, targets)
+    load_adapter_weights(models, payload, expected)
+    for net in models.values():
+        net.requires_grad_(False)
+        net.eval()
+    return expected
